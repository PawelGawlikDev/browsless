{
  "name": "browsless-v2",
  "displayName": "BrowsLess",
  "version": "1.0.0",
  "description": "An extension for automating your browser by connecting blocks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "lint": "eslint entrypoints src wxt.config.ts global.d.ts eslint.config.mjs",
    "lint:fix": "eslint entrypoints src wxt.config.ts global.d.ts eslint.config.mjs --fix",
    "format": "prettier entrypoints src wxt.config.ts global.d.ts eslint.config.mjs prettier.config.mjs package.json tsconfig.json .gitignore --ignore-unknown --write",
    "format:check": "prettier entrypoints src wxt.config.ts global.d.ts eslint.config.mjs prettier.config.mjs package.json tsconfig.json .gitignore --ignore-unknown --check",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
